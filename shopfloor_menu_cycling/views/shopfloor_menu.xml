<odoo>
    <record id="shopfloor_menu_form_view" model="ir.ui.view">
        <field name="model">shopfloor.menu</field>
        <field name="inherit_id" ref="shopfloor.shopfloor_menu_form_view" />
        <field name="arch" type="xml">
            <group name="move_line_processing_sort_order_custom_code" position="after">
                <group name="menu_cycling" invisible="enable_menu_cycling == True">
                    <field name="next_shopfloor_menu_ids" />
                </group>
            </group>
        </field>
    </record>
</odoo>
